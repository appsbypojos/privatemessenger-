{
  "expo": {
    "name": "Private Messenger",
    "slug": "private-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "privatemessenger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "android": {
      "package": "com.privatemessenger.app",
      "permissions": []
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}